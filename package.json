{
  "name": "ring-oauth",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "clean": "pnpm run -r clean",
    "build:lib": "pnpm run -r --filter './packages/core' lib",
    "build:core": "pnpm run -r --filter './packages/core' build",
    "build:application": "pnpm run -r --filter './packages/application' build",
    "build:infra": "pnpm run -r --filter './packages/infrastructure/**' build && pnpm run -r --filter './packages/ioc' build",
    "build:presentation": "pnpm run -r --filter './packages/presentation/**' build",
    "build:all": "pnpm run -r build",
    "build": "pnpm run build:all",
    "start": "pnpm run -r --parallel --if-present  --filter './packages/presentation/*' start",
    "start:dev": "pnpm run -r --parallel --if-present --filter './packages/presentation/*' start:dev",
    "start:debug": "pnpm run -r --parallel --if-present --filter './packages/presentation/*' start:debug"
  },
  "keywords": [],
  "author": "",
  "license": "LICENCE",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ring-oauth/cli": "workspace:^",
    "@sinclair/typebox-codegen": "^0.11.1",
    "rimraf": "^6.0.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "resolutions": {
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-eslint-plugin": "^6.2.0"
  }
}