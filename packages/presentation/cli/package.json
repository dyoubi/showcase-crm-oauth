{
  "name": "@ring-oauth/cli",
  "description": "A new CLI generated with oclif",
  "version": "0.0.0",
  "author": "farod",
  "bin": {
    "cli": "./bin/run.js"
  },
  "dependencies": {
    "@egc-io/ckit-lib": "^1.5.0",
    "@inquirer/prompts": "^7.8.4",
    "@oclif/core": "^4.5.2",
    "@oclif/plugin-help": "^6.2.32",
    "@oclif/plugin-plugins": "^5.4.46",
    "@ring-oauth/application": "workspace:^",
    "@ring-oauth/core": "workspace:^",
    "@ring-oauth/i18n": "workspace:^",
    "@ring-oauth/infra-database": "workspace:^",
    "@ring-oauth/infra-domain": "workspace:^",
    "@ring-oauth/infra-email": "workspace:^",
    "@ring-oauth/infra-redis": "workspace:^",
    "@ring-oauth/theme": "workspace:^",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.1.13",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "chai": "^6.0.1",
    "eslint": "^9.34.0",
    "eslint-config-oclif": "^6.0.101",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.7.2",
    "oclif": "^4.22.16",
    "shx": "^0.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "cli",
    "dirname": "cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "hooks": {
      "init": [
        "./dist/hooks/init/globals",
        "./dist/hooks/init/profile-start"
      ],
      "finally": [
        "./dist/hooks/finally/profile-stop"
      ]
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}